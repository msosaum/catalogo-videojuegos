<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>uy.edu.um.pa</groupId>
  <artifactId>catalogo-videojuegos</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Catalogo de Videojuegos - Entregable 4</name>
  <description>Sistema multi-modulo con pipeline CI/CD en Jenkins</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>modulo-catalogo</module>
    <module>modulo-clasificacion</module>
    <module>app-web</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>uy.edu.um.pa</groupId>
        <artifactId>modulo-catalogo</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>uy.edu.um.pa</groupId>
        <artifactId>modulo-clasificacion</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Pruebas unitarias: *Test.java -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
            <excludes>
              <exclude>**/*IT.java</exclude>
            </excludes>
          </configuration>
        </plugin>
        <!-- Pruebas de integracion: *IT.java -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
